{
  "version": "0.3.1",
  "name": "balanced_5m",
  "train_rows": 5000000,
  "language_fractions": {
    "en": 0.5,
    "ko": 0.4,
    "other": 0.1
  },
  "reserve_rows": {
    "validation": 10000,
    "temperature": 4000,
    "conformal": 4000,
    "test": 10000
  },
  "max_state_tokens": 2048,
  "max_pair_tokens": 256,
  "max_candidates": 20,
  "seed": 20260929,
  "derived_nli_entailment": true,
  "disk_min_gib": 150,
  "max_candidate_rows": 9500000,
  "auto_retry_count": 4,
  "source_failure_policy": "required_sources_fail; optional_sources_reported; quotas_never_relaxed",
  "training": {
    "epochs": 2,
    "english_reference_epochs": 1,
    "batch_size": 2,
    "accumulation": 32,
    "encoder_lr": 2e-05,
    "head_lr": 0.0001,
    "eval_every": 10000,
    "save_every": 1000,
    "log_every": 50,
    "validation_limit": 6000,
    "patience": 1000000,
    "bf16": true,
    "gradient_checkpointing": true,
    "threads": 8
  },
  "evaluation": {
    "batch_size": 2,
    "device": "cuda",
    "native_parity_samples": 8,
    "english_guard_accuracy_drop": 0.0,
    "english_guard_nll_increase": 0.0
  },
  "notes": [
    "5M counts accepted tokenizable training DECISIONS, not 5M independent source documents.",
    "Originals, source groups and derived decisions are reported separately. Source licensing/provenance remains separate from code license.",
    "All SNLI/MNLI/KorNLI/XNLI training is train-only to avoid unverified translation alignment across partitions.",
    "PAWS-X and MASSIVE translations share origin groups. Group components touching official test/development drop training overlap.",
    "The optional 100M-token masked-LM adaptation and Julia/Laya downloads are not automatically included.",
    "No API keys, generated gold labels, random truth labels, repeat-to-fill or silent target reduction. A shortage fails before training."
  ],
